# Supabase project settings (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Required for Super Admin to create user accounts.
# Use the secret key from Supabase API Keys. Never add NEXT_PUBLIC_ or commit a real value.
SUPABASE_SECRET_KEY=
# Legacy deployments can keep using SUPABASE_SERVICE_ROLE_KEY instead.

# Used for email verification and password recovery links. Set your HTTPS Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Choose gmail or resend for VIP Queue reminders.
EMAIL_PROVIDER=resend

# Gmail SMTP: enable Google 2-Step Verification, then create an App Password.
# Never use your normal Google password. Gmail sends from GMAIL_USER.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional monitored inbox for student replies.
GMAIL_REPLY_TO_EMAIL=

# Resend (used only when EMAIL_PROVIDER=resend).
RESEND_API_KEY=
# A mailbox on your verified Resend domain, e.g. supplies@your-university.edu
RESEND_FROM_EMAIL=
# Optional monitored inbox for student replies.
RESEND_REPLY_TO_EMAIL=
